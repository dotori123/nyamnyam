rules_version = '2';

// 냥냠냠 Firestore 보안 규칙
//
// 규칙 하나: 로그인한 사람은 자기 문서만 읽고 쓴다.
// 데이터 경로가 users/{uid}/... 라서 uid 비교 한 줄이면 끝난다.
//
// 여기 적히지 않은 경로는 자동으로 거부된다 (Firestore 기본값이 거부).
// 그래서 "나머지 전부 차단" 같은 줄을 따로 쓸 필요가 없다.
//
// 넣는 법: 콘솔 → Firestore Database → 규칙 탭 →
//         편집기에 있던 내용을 전부 지우고 이 파일을 통째로 붙여넣은 뒤 게시.
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} 문서 자체
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 그 아래 전부 (cats/*, records/*, 앞으로 추가될 것들까지)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
