{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],

    "rewrites": [
      {
        "//": "SPA — /records/123 같은 주소로 새로고침해도 index.html을 돌려준다",
        "source": "**",
        "destination": "/index.html"
      }
    ],

    "headers": [
      {
        "//": "파일명에 해시가 붙는 것들만 오래 캐시한다. 내용이 바뀌면 이름이 바뀐다",
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "//": "index.html은 절대 캐시하지 않는다. 여기가 낡으면 새 배포를 영영 못 받는다",
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "//": "서비스워커도 마찬가지. 낡은 sw.js가 낡은 캐시를 계속 물고 있게 된다",
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },

  "firestore": {
    "rules": "firestore.rules"
  }
}
